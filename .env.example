# Copy to .env and fill in. .env is gitignored; never commit real keys.

# LLM provider keys — used by the router, fe_codegen, and reporter nodes only.
# Only the key for the provider in AUTODS_MODEL (or the config default) is needed.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: overrides the default model set in src/autods/config.py.
# Format is "<provider>:<model-id>", e.g. openai:gpt-6-luna or anthropic:claude-opus-5-5
# (the anthropic provider also needs `uv add langchain-anthropic`).
# AUTODS_MODEL=

# Optional: set to 1 to log every LLM request/response payload (noisy).
# AUTODS_DEBUG_LLM=0
