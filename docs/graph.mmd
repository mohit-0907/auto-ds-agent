---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	profiler(profiler)
	router(router)
	sanity_check(sanity_check)
	fe_codegen(fe_codegen)
	sandbox(sandbox)
	fallback_fe(fallback_fe)
	arena(arena)
	artifacts(artifacts)
	reporter(reporter)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> profiler;
	arena --> artifacts;
	artifacts --> reporter;
	fallback_fe -.-> arena;
	fallback_fe -. &nbsp;report&nbsp; .-> reporter;
	fe_codegen -.-> fallback_fe;
	fe_codegen -.-> sandbox;
	profiler --> router;
	reporter --> finalize;
	router --> sanity_check;
	sandbox -.-> arena;
	sandbox -.-> fallback_fe;
	sandbox -.-> fe_codegen;
	sanity_check -.-> fe_codegen;
	sanity_check -. &nbsp;report&nbsp; .-> reporter;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
